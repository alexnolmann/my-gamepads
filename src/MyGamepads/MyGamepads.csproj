<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <AssemblyName>MyGamepads</AssemblyName>
    <RootNamespace>MyGamepads</RootNamespace>
    <Product>Мои геймпады</Product>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Description>Wireless Controller to Xbox 360 bridge</Description>
    <Version>1.0.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/src/MyGamepads</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/app.ico" LogicalName="MyGamepads.App.ico" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <EmbeddedResource Include="../../drivers/ViGEmBus/ViGEmBus_1.22.0_x64_x86_arm64.exe" LogicalName="MyGamepads.ViGEmBus.exe" />
    <EmbeddedResource Include="../../THIRD-PARTY-NOTICES.txt" LogicalName="MyGamepads.Notices.txt" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="MyGamepads.License.txt" />
  </ItemGroup>
</Project>
